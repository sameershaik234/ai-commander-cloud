# Keep this file private. Copy to .env and replace every value.
# Recommended: free Groq key from https://console.groq.com/keys
GROQ_API_KEY=replace_me
# Optional alternative provider (used only when GROQ_API_KEY is not set)
OPENAI_API_KEY=replace_me
# Optional model overrides
# AI_MODEL=openai/gpt-oss-120b
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# STT_MODEL=whisper-large-v3-turbo
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
OWNER_SETUP_KEY=replace_with_a_different_random_first_run_key
DATA_DIR=./data
