{"title": "GERALD VS CYBER MONDAY", "total": 28.331833333333332, "lines": [{"i": 0, "scene": 0, "text": "Gerald is back. After Black Friday, he swore he'd never go shopping again.", "caption": "Gerald is back. After Black Friday, he swore he'd never go shopping again.", "start": 0.0, "end": 4.751166666666666}, {"i": 1, "scene": 1, "text": "Then he heard about Cyber Monday. Shopping, from your phone.", "caption": "Then he heard about Cyber Monday. Shopping, from your phone.", "start": 5.251166666666666, "end": 8.908166666666666}, {"i": 2, "scene": 2, "text": "No crowds. No stampede. Just Gerald, his pumpkin, and one little button.", "caption": "No crowds. No stampede. Just Gerald, his pumpkin, and one little button.", "start": 9.408166666666666, "end": 14.047374999999999}, {"i": 3, "scene": 3, "text": "He pressed it once. Then twice. Then, a few hundred times.", "caption": "He pressed it once. Then twice. Then, a few hundred times.", "start": 14.447375000000001, "end": 18.362083333333334}, {"i": 4, "scene": 4, "text": "The next morning, the doorbell rang.", "caption": "The next morning, the doorbell rang.", "start": 18.962083333333332, "end": 21.245708333333333}, {"i": 5, "scene": 5, "text": "Gerald now lives inside a mountain of boxes.", "caption": "Gerald now lives inside a mountain of boxes.", "start": 21.745708333333333, "end": 24.970291666666668}, {"i": 6, "scene": 6, "text": "Somebody stop him before Christmas.", "caption": "Somebody stop him before Christmas.", "start": 25.470291666666668, "end": 27.931833333333334}], "sceneStarts": [0.0, 5.251166666666666, 9.408166666666666, 14.447375000000001, 18.962083333333332, 21.745708333333333, 25.470291666666668], "caps": [[0.0, 1.4052746478873237, "Gerald is back. After"], [1.4052746478873237, 2.8774671361502344, "Black Friday, he swore"], [2.8774671361502344, 3.7473990610328634, "he'd never go"], [3.7473990610328634, 4.751166666666666, "shopping again."], [5.251166666666666, 6.470166666666667, "Then he heard about"],